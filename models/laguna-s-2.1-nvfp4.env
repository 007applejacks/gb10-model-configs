# UI-imported model recipe (host-local; gitignored). Promote via Export to version it.
# Tuning knobs (spec-decode/KV/sampling) are pinned OFF — validate + tune before trusting.
# QUANT fixed to auto (import default guessed "modelopt" from the repo name, which vLLM rejected —
# the checkpoint's real quant_method is compressed-tensors/nvfp4-pack-quantized; auto omits
# --quantization and lets vLLM read it from the checkpoint itself).

# --- UI metadata ---
UI_LABEL="Laguna-S-2.1-NVFP4"
UI_DESC="Sparse-MoE poolside Laguna (custom LagunaForCausalLM arch, trust_remote_code), 256 experts/top_k=10, NVFP4 experts + unquantized attention (compressed-tensors nvfp4-pack-quantized). First serve 2026-07-26: 9-test stability battery passed clean (0 failures, 47.6 tok/s). BBH CoT reasoning solid (0.53 exact-match). MMLU/GSM8K/HellaSwag/TruthfulQA scored near chance under lm-eval's zero-shot direct-letter format — spot-checked raw logprobs (sequential + concurrent, echo + non-echo) and reran MMLU at 4x context (2048->8192, no change: 0.249->0.256) to rule out a serving/harness bug. Model defaults to a thinking-first chat template; likely just can't do forced single-token zero-shot MC without CoT room, not a real knowledge gap. Trust the CoT/generation-based results; treat the raw MC numbers as unvalidated, not as a quality verdict."
UI_SIZE="~72 GB · MoE (256 experts, top-10 active) · 256K ctx"
UI_SPEED="~47.6 tok/s (measured 2026-07-26)"
UI_USE_CASES="Agentic / CoT reasoning tasks, Experimental — needs fewshot or CoT-style quality re-eval before trusting on knowledge-recall tasks"
EXPERIMENTAL="0"

# --- Serve recipe ---
SERVE_MODEL="poolside/Laguna-S-2.1-NVFP4"
SERVED_NAME="laguna-s-2.1-nvfp4"
SERVE_CONTAINER="swap-vllm-laguna-s-2.1-nvfp4"
SERVE_PORT="8002"
MAX_LEN="262144"
GPU_UTIL="0.85"
QUANT="auto"
TOOLS="1"
REASONING_PARSER="qwen3"
KV_ARG=""
GENCFG_ARG=""
EXTRA_ARGS=""
SPEC_ARG=""
COMPILE_ARG=""
