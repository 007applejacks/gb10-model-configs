# Official Qwen block-scaled FP8 checkpoint. Native 256K context, vision.
#
# No speculative decoding: MTP corrupts logprob/loglikelihood scoring on this model's GDN
# hybrid-attention architecture (confirmed on vLLM v0.27.1 and v0.28.0).
# --max-num-batched-tokens 8192 / --performance-mode interactivity: larger prefill chunks for
# long-context reads, finer cudagraph capture for low-concurrency latency.
#
# Stats (measured 2026-09-02, vLLM v0.28.0-aarch64):
#   Size:      ~30.9 GB (FP8 block-scaled)
#   Decode:    ~22.9 tok/s cold-start, ~24-32 tok/s warm (concurrency=4, 512in/128out)
#   MMLU:      0.842-0.892 (62 subtasks, 5-shot limit, n=310)
#   Stability: full battery passed (cold + warm), all_passed=true

# --- UI metadata ---
UI_LABEL="Qwen3.8-27B-FP8"
UI_DESC="Official Qwen block-scaled FP8 checkpoint. No spec-decode (MTP corrupts logprob scoring on this architecture). Tuned for long-context + low-concurrency. ~30.9GB, native 256K context. MMLU ~0.84-0.89, ~24-32 tok/s decode."
UI_SIZE="~30.9 GB · FP8 block-scaled · vision · 256K ctx"
UI_SPEED="~24-32 tok/s (measured 2026-09-02)"
UI_USE_CASES="Vision Q&A, Long-context (256K) reading, Agentic tool-use"
EXPERIMENTAL="0"

# --- Serve recipe ---
SERVE_MODEL="Qwen/Qwen3.8-27B-FP8"
SERVED_NAME="qwen3.8-27b-fp8"
SERVE_CONTAINER="swap-vllm-qwen3.8-27b-fp8"
SERVE_PORT="8002"
MAX_LEN="262144"
GPU_UTIL="0.85"
QUANT="fp8"
TOOLS="1"
REASONING_PARSER="qwen3"
KV_ARG=""
GENCFG_ARG=""
EXTRA_ARGS="--max-num-batched-tokens 8192 --performance-mode interactivity"
SPEC_ARG=""
COMPILE_ARG=""
