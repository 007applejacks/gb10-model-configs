# UI-imported model recipe (host-local; gitignored). Promote via Export to version it.
# Tuning knobs (spec-decode/KV/sampling) are pinned OFF — validate + tune before trusting.

# --- UI metadata ---
UI_LABEL="Qwen3.8-27B-NVFP4 (unsloth)"
UI_DESC="Imported from HuggingFace — recipe is provisional, validate before relying on it. Community compressed-tensors mixed-precision quant (FP8 attn/lm_head/last-8-layer MLP + NVFP4 most-MLP; vision tower + linear_attn layers + MTP head left unquantized). quant_method=compressed-tensors, NOT ModelOpt — importer heuristic mis-detected modelopt from the literal string nvfp4 in the config blob; corrected to auto so vLLM self-detects from quantization_config. Native context 262144 (same fix as the BF16 base: nested under text_config, importer default was wrong)."
UI_SIZE="~23.4 GB · mixed FP8/NVFP4 (compressed-tensors) · vision"
UI_SPEED="~39.4 tok/s (measured 2026-08-16)"
UI_USE_CASES=""
EXPERIMENTAL="0"

# --- Serve recipe ---
SERVE_MODEL="unsloth/Qwen3.8-27B-NVFP4"
SERVED_NAME="qwen3.8-27b-nvfp4"
SERVE_CONTAINER="swap-vllm-qwen3.8-27b-nvfp4"
SERVE_PORT="8002"
MAX_LEN="262144"
GPU_UTIL="0.85"
QUANT="auto"
TOOLS="1"
REASONING_PARSER="qwen3"
