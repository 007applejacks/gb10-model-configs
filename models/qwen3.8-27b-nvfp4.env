# UI-imported model recipe (host-local; gitignored). Promote via Export to version it.
# Spec-decode/cudagraph/KV-cache tuning validated 2026-08-18 (was previously pinned off pending
# validation, see git history). Falls through to gb10-serve.sh's defaults: MTP k=3 + forced
# PIECEWISE cudagraph + explicit bf16 KV cache -- see that script's SPEC_ARG comment for the
# k=3/k=4 history this inherits (k=4 was never validated for this model; don't assume it applies).
# Two back-to-back stability-battery runs: first (immediately post-swap, still warming up)
# measured 35.2 tok/s with an outlier 53.9s P99 TTFT; second (container warm/idle) measured
# 74.1 tok/s clean -- the second is the trustworthy number, first was cold-start noise, not a
# real regression. Both passed all_passed=true. ~1.9x the pre-spec-decode baseline (39.4 tok/s,
# 2026-08-16) -- MTP acceptance rate ~62%, acceptance length ~2.87 tokens/draft.

# --- UI metadata ---
UI_LABEL="Qwen3.8-27B-NVFP4"
UI_DESC="unsloth's compressed-tensors mixed-precision quant of Qwen3.8-27B — FP8 for attention/lm_head/last-8-layer MLP, NVFP4 for most MLP layers; vision tower, linear-attention layers, and MTP head left unquantized. ~23.4GB vs. 55.4GB for the bf16 original (qwen3.8-27b), same native 256K context. Validated 2026-08-18: full stability battery passed with MTP spec-decode (k=3) + forced PIECEWISE cudagraph + explicit bf16 KV cache now enabled, ~74.1 tok/s decode (~1.9x the prior no-spec-decode config, ~4.5x the bf16 sibling) — the faster default choice of the two unless you specifically need full precision."
UI_SIZE="~23.4 GB · mixed FP8/NVFP4 (compressed-tensors) · vision"
UI_SPEED="~74.1 tok/s (measured 2026-08-18)"
UI_USE_CASES="Vision Q&A, Long-context (256K) reading, Agentic tool-use, Fast iteration"
EXPERIMENTAL="0"

# --- Serve recipe ---
SERVE_MODEL="unsloth/Qwen3.8-27B-NVFP4"
SERVED_NAME="qwen3.8-27b-nvfp4"
SERVE_CONTAINER="swap-vllm-qwen3.8-27b-nvfp4"
SERVE_PORT="8002"
MAX_LEN="262144"
GPU_UTIL="0.85"
QUANT="auto"
TOOLS="1"
REASONING_PARSER="qwen3"
EXTRA_ARGS=""
