# NVIDIA ModelOpt mixed-precision checkpoint of Qwen3.8-27B: NVFP4 on the MLP layers + lm_head, FP8 on
# attention / linear-attention; the native MTP layer is kept (unquantized). Same architecture, 256K
# context, vision as qwen3.8-27b-fp8. On GB10 the FP4 layers run as W4A16 (no native FP4 tensor-core
# path), but the ~40% smaller weights cut the bandwidth-bound decode cost.
#
# Speculative decoding: native MTP, k=3. Swept on vLLM v0.31.0 (Model Runner V2), 2026-10-10
# (single-stream / concurrency-4 tok/s; 32-trial strict tool gate failures):
#     no spec        11.88 /  44.2   0/32
#     k=3            27.73 /  94.6   0/32  <- chosen   (soak re-run: 28.68 / 101.7)
#     k=4            25.72 /  88.3   0/32
#     k=4+fp8 KV     25.76 /  83.4   0/32  (KV 1.96M tok vs 1.06M) -- capacity option, not adopted
#   k=3 passed a 15-min mixed-load soak: 129 ok / 0 err, 43/43 tool calls valid, server log clean.
#   vs qwen3.8-27b-fp8 (k=4): ~1.7x single-stream, ~1.5x concurrency-4.
#   NOT yet measured: MMLU / output-quality delta vs the FP8 checkpoint.
# Card (nvidia/Qwen3.8-27B-NVFP4) suggests --kv-cache-dtype fp8_e4m3; we left KV at bf16 for speed.

# --- UI metadata ---
UI_LABEL="Qwen3.8-27B-NVFP4"
UI_DESC="NVIDIA ModelOpt NVFP4 (MLP) + FP8 (attention) Qwen3.8-27B with native MTP speculative decoding (k=3). Fastest tested config on the GB10: ~28 tok/s single-stream, ~95-100 tok/s at concurrency 4. Native 256K context."
UI_SIZE="~21.9 GB · NVFP4/FP8 mixed · vision · 256K ctx"
UI_SPEED="~28 tok/s single, ~95-100 tok/s conc-4 (measured 2026-10-10)"
UI_USE_CASES="Vision Q&A, Long-context (256K) reading, Agentic tool-use"
EXPERIMENTAL="0"

# --- Serve recipe ---
SERVE_MODEL="nvidia/Qwen3.8-27B-NVFP4"
SERVED_NAME="qwen3.8-27b-nvfp4"
SERVE_CONTAINER="swap-vllm-qwen3.8-27b-nvfp4"
SERVE_PORT="8002"
MAX_LEN="262144"
GPU_UTIL="0.85"
QUANT="auto"
TOOLS="1"
REASONING_PARSER="qwen3"
KV_ARG=""
GENCFG_ARG=""
EXTRA_ARGS="--max-num-batched-tokens 8192 --performance-mode interactivity"
SPEC_ARG="--speculative-config '{\"method\":\"mtp\",\"num_speculative_tokens\":3}'"
COMPILE_ARG=""
# Init takes ~930 s (FlashInfer autotune + cudagraph capture); gb10-serve.sh defaults to a 900 s health wait.SERVE_TIMEOUT="1500"
