# UI-imported model recipe (host-local; gitignored). Promote via Export to version it.
# Tuning knobs (spec-decode/KV/sampling) are pinned OFF — validate + tune before trusting.

# --- UI metadata ---
UI_LABEL="Qwen3.8-27B-NVFP4"
UI_DESC="unsloth's compressed-tensors mixed-precision quant of Qwen3.8-27B — FP8 for attention/lm_head/last-8-layer MLP, NVFP4 for most MLP layers; vision tower, linear-attention layers, and MTP head left unquantized. ~23.4GB vs. 55.4GB for the bf16 original (qwen3.8-27b), same native 256K context. Validated 2026-08-16: full 9-test stability battery passed, ~39.4 tok/s decode (~2.4x the bf16 sibling) — the faster default choice of the two unless you specifically need full precision."
UI_SIZE="~23.4 GB · mixed FP8/NVFP4 (compressed-tensors) · vision"
UI_SPEED="~39.4 tok/s (measured 2026-08-16)"
UI_USE_CASES="Vision Q&A, Long-context (256K) reading, Agentic tool-use, Fast iteration"
EXPERIMENTAL="0"

# --- Serve recipe ---
SERVE_MODEL="unsloth/Qwen3.8-27B-NVFP4"
SERVED_NAME="qwen3.8-27b-nvfp4"
SERVE_CONTAINER="swap-vllm-qwen3.8-27b-nvfp4"
SERVE_PORT="8002"
MAX_LEN="262144"
GPU_UTIL="0.85"
QUANT="auto"
TOOLS="1"
REASONING_PARSER="qwen3"
KV_ARG=""
GENCFG_ARG=""
EXTRA_ARGS=""
SPEC_ARG=""
COMPILE_ARG=""
